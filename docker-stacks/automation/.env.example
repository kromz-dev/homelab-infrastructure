# ==========================================
# HOMELAB AUTOMATION STACK - ENVIRONMENT VARIABLES
# ==========================================

TZ=Europe/Paris

# Pinned: n8n migrates its database on upgrade, so bump this deliberately (tested: 2.41.4).
N8N_TAG=2.41.4

# Generate once with `openssl rand -hex 32` and back it up OFF this host.
# Losing it makes every stored credential unreadable.
N8N_ENCRYPTION_KEY=change-me

N8N_HOST=192.168.1.151
PORT_N8N=5678
