[
  {
    "id": "cred-mail-imap",
    "name": "Gmail IMAP",
    "type": "imap",
    "data": {
      "user": "${GMAIL_USER}",
      "password": "${GMAIL_APP_PASSWORD}",
      "host": "imap.gmail.com",
      "port": 993,
      "secure": true,
      "allowUnauthorizedCerts": false
    }
  },
  {
    "id": "cred-mail-groq",
    "name": "Groq API",
    "type": "httpHeaderAuth",
    "data": {
      "name": "Authorization",
      "value": "Bearer ${GROQ_API_KEY}"
    }
  },
  {
    "id": "cred-mail-telegram",
    "name": "Telegram bot",
    "type": "telegramApi",
    "data": {
      "accessToken": "${TELEGRAM_TOKEN}",
      "baseUrl": "https://api.telegram.org"
    }
  }
]