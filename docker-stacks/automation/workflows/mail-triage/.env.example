# Copy to `.env` on the server (chmod 600) and fill in. Never commit the real file.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
GROQ_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# First-run cutoff: only mails with a UID >= this are processed. Without it the IMAP
# trigger starts from every unread mail in the inbox (15k+ here). Set it to (highest
# UID in INBOX + 1) when first deploying; n8n tracks the last UID itself afterwards.
IMAP_FROM_UID=1
# Senders (domains or full addresses, comma-separated, no spaces or quotes) whose mail
# is always "important" and never sent to Groq. Add your bank here.
VIP_SENDERS=francetravail.fr,pole-emploi.fr,urssaf.fr,impots.gouv.fr
# When the evening digest of ignored mail is sent (cron, Europe/Paris). Quotes required.
DIGEST_CRON="0 20 * * *"
